FROM node:20-alpine

# Install git and rsync (required by pando CLI)
RUN apk add --no-cache git rsync bash

# Configure git for test operations
RUN git config --global user.email "test@example.com" && \
    git config --global user.name "Test User" && \
    git config --global init.defaultBranch main

# Install pando globally from npm.
# PANDO_VERSION pins the exact published version under test (set from the release
# tag in CI). Defaults to `latest` so local runs work without wiring anything.
ARG PANDO_VERSION=latest
RUN npm install -g "@zyoung-ff/pando@${PANDO_VERSION}"

# Verify installation
RUN pando --version

# Create working directory
WORKDIR /app

# Keep container running for exec commands
CMD ["tail", "-f", "/dev/null"]
